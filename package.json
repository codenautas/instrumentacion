{
  "name": "instrumentacion",
  "description": "Módulo de Instrumentacion",
  "version": "3.0.0",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "repository": "codenautas/instrumentacion",
  "license": "MIT",
  "main": "dist/server/app-instrumentacion.js",
  "types": "dist/server/app-instrumentacion.d.ts",
  "files": [
    "dist",
    "install",
    "unlogged"
  ],
  "dependencies": {
    "@mui/material": "^5.18.0",
    "backend-plus": "^2.8.0",
    "backend-skins": "^0.1.38",
    "js-to-html": "^2.0.0-betha",
    "mini-tools": "^1.13.4",
    "mixin-patch": "^1.0.0",
    "pg-triggers": "~0.4.3",
    "react": "~17.0.2",
    "react-dom": "~17.0.2",
    "sql-tools": "^0.1.4",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "copyfiles": "~2.4.1",
    "express-useragent": "^2.2.3",
    "mocha": "^11.8.0"
  },
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "test": "npm run build && mocha --reporter spec --bail --check-leaks tests/tests/*.js",
    "test-cov": "istanbul cover node_modules/mocha/bin/_mocha -- --reporter dot --check-leaks tests/tests/",
    "start": "node dist/server/server-instrumentacion.js",
    "prepare": "npm run build",
    "cp": "copyfiles -f src/client/img/* dist/client/img",
    "build": "npm run cp && tsc -p tsconfig-client.json && tsc -p tsconfig-server.json && mixin-patch",
    "watch:buildC": "tsc -p src/client --watch",
    "watch:buildS": "tsc -p src/server --watch"
  },
  "qa-control": {
    "package-version": "0.3.0",
    "coverage": 90,
    "run-in": "server",
    "stability": "extending",
    "type": "lib",
    "ecmaVersion": 6
  }
}
